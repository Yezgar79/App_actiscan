# Seguridad Flask — genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-secreta-flask

# URL pública del backend (servicio actiscan-api en Railway)
API_BASE_URL=https://tu-backend.up.railway.app

FLASK_ENV=production
ENVIRONMENT=production
SESSION_COOKIE_SECURE=true
WTF_CSRF_ENABLED=true
API_TIMEOUT=10
