# Base de datos — Railway provee DATABASE_URL automáticamente al vincular el servicio PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Seguridad — genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=production

# Orígenes permitidos para CORS (separados por coma, sin espacios)
# Incluye la URL de Vercel (frontend) y la URL del web admin en Railway
ALLOWED_ORIGINS=https://tu-frontend.vercel.app,https://tu-web.up.railway.app

# Controla si se ejecuta el seed al iniciar el contenedor
# Ponlo en false después del primer deploy exitoso
SEED_ON_STARTUP=true
