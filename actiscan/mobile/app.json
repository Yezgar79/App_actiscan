{
  "expo": {
    "name": "ActiScan",
    "slug": "actiscan",
    "version": "1.0.0",
    "updates": {
      "enabled": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "scheme": "actiscan",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A2B4A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "mx.actiscan.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A2B4A"
      },
      "package": "mx.actiscan.app",
      "permissions": ["CAMERA"]
    },
    "plugins": [
      "expo-router",
      ["expo-camera", { "cameraPermission": "Necesitamos acceso a la cámara para escanear códigos QR de activos." }]
    ]
  }
}
